# Keep the app local while developing.
APP_HOST=127.0.0.1
APP_PORT=8000
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=
# Optional absolute path for SQLite storage (use a persistent disk for hosted history).
DATABASE_PATH=
# Optional GitHub token for a higher public API rate limit; never commit a real token.
GITHUB_TOKEN=
# Optional YouTube Data API v3 key; each username scan uses one search request.
YOUTUBE_API_KEY=
